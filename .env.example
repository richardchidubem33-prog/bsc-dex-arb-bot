# Safe scanner defaults
MODE=mock
EXECUTION=paper
LIVE_TRADING_ENABLED=false
MIN_PROFIT_USD=5
GAS_USD=0.35
FLASH_FEE_BPS=9
MAX_SLIPPAGE_BPS=50
MAX_TRADE_USD=25
SCAN_INTERVAL_SECONDS=15

# Optional read-only RPC scanner (never put private keys here)
BSC_RPC_URL=
ROUTES_JSON=
# Or use one legacy route:
ROUTE_NAME=WBNB/USDT
ROUTER_A_ADDRESS=
ROUTER_B_ADDRESS=
TOKEN_IN_ADDRESS=
TOKEN_MID_ADDRESS=
TOKEN_IN_DECIMALS=18
TOKEN_MID_DECIMALS=18
AMOUNT_IN=0.1

# Contract deployment inputs: only for local/fork work until independently reviewed
AAVE_ADDRESSES_PROVIDER=
AAVE_POOL=
PROFIT_RECIPIENT=
ALLOW_EXECUTOR_DEPLOYMENT=false
